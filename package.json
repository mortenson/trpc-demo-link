{
  "name": "trpc-demo-link",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "build:client": "npm run build -w client",
    "build:server": "npm run build -w server",
    "build": "run-s build:server build:client",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "dev": "run-p dev:*",
    "lint:client": "npm run lint -w client",
    "lint:server": "npm run lint -w server",
    "lint": "run-p lint:*",
    "fmt": "oxfmt",
    "start:client": "npm run start -w client",
    "start:server": "npm run start -w server",
    "start": "run-p start:*",
    "test:e2e": "playwright test",
    "test-dev": "start-server-and-test dev http://localhost:3012 test:e2e",
    "test-start": "start-server-and-test start http://localhost:3012 test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.76.0",
    "start-server-and-test": "^1.12.0",
    "wait-port": "^1.1.0"
  }
}
